@model DanialNetFood.Web.Models.ViewModels.CartViewModel

<div id="cart-container" class="p-4 bg-white shadow-lg rounded-lg">
    <h3 class="text-xl font-bold mb-4">سبد خرید</h3>
    @if (Model.Items.Any())
    {
        <ul>
            @foreach (var item in Model.Items)
            {
                <li class="flex justify-between items-center mb-2 border-b pb-2">
                    <div>
                        <p class="font-semibold">@item.FoodName</p>
                        <p class="text-sm text-gray-600">@item.Quantity x @item.Price.ToString("N0") تومان</p>
                    </div>
                    <button onclick="removeFromCart(@item.FoodId)" class="text-red-500 hover:text-red-700">حذف</button>
                </li>
            }
        </ul>
        <div class="mt-4 pt-4 border-t">
            <p class="text-lg font-bold">جمع کل: @Model.TotalAmount.ToString("N0") تومان</p>
            <a asp-controller="Order" asp-action="Checkout" class="block w-full mt-4 bg-green-500 text-white text-center py-2 rounded hover:bg-green-600 transition">تکمیل سفارش</a>
        </div>
    }
    else
    {
        <p class="text-gray-500 text-center">سبد خرید شما خالی است.</p>
    }
</div>
