<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - پنل پیک DanialNetFood</title>
    <link rel="stylesheet" href="/css/site.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @@font-face {
            font-family: 'Vazirmatn';
            src: url('/fonts/Vazirmatn-Regular.woff2') format('woff2');
        }
        body { font-family: 'Vazirmatn', sans-serif; }
    </style>
</head>
<body class="bg-gray-100">
    <header class="bg-orange-600 text-white p-4 shadow-lg sticky top-0 z-50">
        <div class="container mx-auto flex justify-between items-center">
            <h1 class="text-xl font-bold">پنل سفیران دانیال</h1>
            <div class="flex items-center space-x-4 space-x-reverse">
                <span class="text-sm">@User.Identity?.Name</span>
                <a href="/Account/Logout" class="bg-orange-700 px-3 py-1 rounded text-sm">خروج</a>
            </div>
        </div>
    </header>

    <main class="container mx-auto p-4">
        @RenderBody()
    </main>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
