@model IEnumerable<DanialNetFood.Web.Models.Order>
@{
    ViewData["Title"] = "مدیریت سفارشات";
    Layout = "_AdminLayout";
}

<table class="w-full text-right border-collapse">
    <thead>
        <tr class="border-b bg-gray-100">
            <th class="p-3">شناسه</th>
            <th class="p-3">مشتری</th>
            <th class="p-3">مبلغ کل</th>
            <th class="p-3">وضعیت فعلی</th>
            <th class="p-3">تغییر وضعیت</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr class="border-b">
                <td class="p-3">@order.Id</td>
                <td class="p-3">@order.UserId</td>
                <td class="p-3">@order.TotalAmount.ToString("N0")</td>
                <td class="p-3">
                    <span id="status-@order.Id" class="px-2 py-1 rounded bg-blue-100 text-blue-800">@order.Status</span>
                </td>
                <td class="p-3">
                    <select onchange="updateStatus(@order.Id, this.value)" class="border p-1 rounded">
                        <option value="">انتخاب کنید</option>
                        <option value="Pending">Pending</option>
                        <option value="Preparing">Preparing</option>
                        <option value="OutForDelivery">OutForDelivery</option>
                        <option value="Delivered">Delivered</option>
                    </select>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        function updateStatus(orderId, status) {
            if (!status) return;
            $.post('/Order/UpdateStatus', { orderId: orderId, status: status }, function() {
                $('#status-' + orderId).text(status);
            });
        }
    </script>
}
