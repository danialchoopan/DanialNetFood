@{
    ViewData["Title"] = "ورود";
}

<div class="max-w-md mx-auto bg-white p-8 rounded-lg shadow mt-10">
    <h2 class="text-2xl font-bold mb-6 text-center">ورود به حساب کاربری</h2>
    <form asp-action="Login" method="post" class="space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>
        <div>
            <label class="block mb-1">نام کاربری</label>
            <input type="text" name="username" class="w-full border p-2 rounded" required>
        </div>
        <div>
            <label class="block mb-1">رمز عبور</label>
            <input type="password" name="password" class="w-full border p-2 rounded" required>
        </div>
        <button type="submit" class="w-full bg-red-600 text-white py-2 rounded font-bold hover:bg-red-700">ورود</button>
    </form>
    <div class="mt-4 text-sm text-gray-600 text-center bg-gray-50 p-4 rounded-lg space-y-1">
        <p>مشتری: <span class="font-mono">customer / 123456</span></p>
        <p>رستوران‌دار: <span class="font-mono">owner / 123456</span></p>
        <p>مدیریت کل: <span class="font-mono">admin / 123456</span></p>
    </div>
</div>
