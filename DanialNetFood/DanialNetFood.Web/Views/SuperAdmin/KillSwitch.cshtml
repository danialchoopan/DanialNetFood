@{
    ViewData["Title"] = "کلید اضطراری";
    Layout = "_SuperAdminLayout";
}

<div class="max-w-2xl bg-white p-8 rounded-xl shadow-sm border border-gray-100">
    <h2 class="text-xl font-bold mb-4">مدیریت دسترسی کل پلتفرم</h2>
    <p class="text-gray-600 mb-8 leading-loose">
        در صورت فعال‌سازی حالت اضطراری، تمامی فرآیندهای ثبت سفارش در کل سایت متوقف شده و به کاربران پیغامی مبنی بر به‌روزرسانی سیستم نمایش داده می‌شود.
    </p>

    <div class="flex items-center justify-between p-6 rounded-lg @(ViewBag.IsActive ? "bg-green-50" : "bg-red-50")">
        <div>
            <div class="font-bold @(ViewBag.IsActive ? "text-green-800" : "text-red-800")">
                وضعیت فعلی: @(ViewBag.IsActive ? "فعال و در دسترس" : "غیرفعال (حالت اضطراری)")
            </div>
        </div>
        <form action="/SuperAdmin/ToggleKillSwitch" method="post">
            <input type="hidden" name="isActive" value="@(ViewBag.IsActive ? "false" : "true")" />
            <button type="submit" class="px-6 py-2 rounded-lg font-bold text-white @(ViewBag.IsActive ? "bg-red-600" : "bg-green-600")">
                @(ViewBag.IsActive ? "قطع موقت خدمات" : "فعال‌سازی مجدد")
            </button>
        </form>
    </div>
</div>
