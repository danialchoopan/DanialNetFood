@model List<DanialNetFood.Web.Models.Order>
@{
    ViewData["Title"] = "داشبورد سفیران";
    Layout = "_DriverLayout";
    var activeOrders = ViewBag.ActiveOrders as List<DanialNetFood.Web.Models.Order>;
}

<div class="space-y-8">
    <!-- Active Delivery -->
    @if (activeOrders != null && activeOrders.Any())
    {
        <section>
            <h2 class="text-lg font-bold mb-4 text-green-700">سفارش در حال حمل</h2>
            @foreach (var order in activeOrders)
            {
                <div class="bg-white p-6 rounded-lg shadow-md border-r-4 border-green-500 flex justify-between items-center">
                    <div>
                        <div class="font-bold">سفارش #@order.Id</div>
                        <div class="text-sm text-gray-600">رستوران دانیال - خیابان اصلی</div>
                    </div>
                    <form action="/Driver/DeliverOrder" method="post">
                        <input type="hidden" name="orderId" value="@order.Id" />
                        <button type="submit" class="bg-green-600 text-white px-6 py-2 rounded-full font-bold">تحویل داده شد</button>
                    </form>
                </div>
            }
        </section>
    }

    <!-- Available Orders -->
    <section>
        <h2 class="text-lg font-bold mb-4">سفارشات آماده ارسال</h2>
        <div id="availableList" class="space-y-4">
            @if (!Model.Any())
            {
                <p class="text-gray-500 italic">در حال حاضر سفارشی برای ارسال وجود ندارد.</p>
            }
            @foreach (var order in Model)
            {
                <div class="bg-white p-6 rounded-lg shadow border-r-4 border-orange-500 flex justify-between items-center">
                    <div>
                        <div class="font-bold">سفارش #@order.Id</div>
                        <div class="text-sm text-gray-600">فاصله تا شما: ۲ کیلومتر</div>
                    </div>
                    <form action="/Driver/AcceptOrder" method="post">
                        <input type="hidden" name="orderId" value="@order.Id" />
                        <button type="submit" class="bg-orange-600 text-white px-6 py-2 rounded-full font-bold">قبول سفارش</button>
                    </form>
                </div>
            }
        </div>
    </section>
</div>

@section Scripts {
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/orderHub")
            .build();

        connection.on("ReceiveNewJob", function (job) {
            // Re-fetch or append
            location.reload();
        });

        connection.start().then(function () {
            connection.invoke("JoinDriverGroup");
        });
    </script>
}
