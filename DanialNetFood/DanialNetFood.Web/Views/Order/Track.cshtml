@model DanialNetFood.Web.Models.Order

<div class="max-w-2xl mx-auto p-6 bg-white shadow rounded">
    <h2 class="text-2xl font-bold mb-6">پیگیری سفارش #@Model.Id</h2>

    <div id="status-container" class="space-y-4">
        <div id="step-Pending" class="p-4 border rounded @(Model.Status == "Pending" ? "bg-blue-100 border-blue-500" : "bg-gray-50")">
            <p class="font-bold">ثبت شده</p>
        </div>
        <div id="step-Preparing" class="p-4 border rounded @(Model.Status == "Preparing" ? "bg-blue-100 border-blue-500" : "bg-gray-50")">
            <p class="font-bold">در حال آماده‌سازی</p>
        </div>
        <div id="step-OutForDelivery" class="p-4 border rounded @(Model.Status == "OutForDelivery" ? "bg-blue-100 border-blue-500" : "bg-gray-50")">
            <p class="font-bold">ارسال شده</p>
        </div>
        <div id="step-Delivered" class="p-4 border rounded @(Model.Status == "Delivered" ? "bg-green-100 border-green-500" : "bg-gray-50")">
            <p class="font-bold">تحویل داده شد</p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/orderHub")
            .build();

        connection.on("ReceiveStatusUpdate", function (status) {
            updateStatusUI(status);
        });

        connection.start().then(function () {
            connection.invoke("JoinOrderGroup", @Model.Id);
        }).catch(err => console.error(err));

        function updateStatusUI(status) {
            const steps = ["Pending", "Preparing", "OutForDelivery", "Delivered"];
            steps.forEach(s => {
                const el = document.getElementById("step-" + s);
                el.className = "p-4 border rounded bg-gray-50";
            });

            const currentEl = document.getElementById("step-" + status);
            if (status === "Delivered") {
                currentEl.className = "p-4 border rounded bg-green-100 border-green-500";
            } else {
                currentEl.className = "p-4 border rounded bg-blue-100 border-blue-500";
            }
        }
    </script>
}
