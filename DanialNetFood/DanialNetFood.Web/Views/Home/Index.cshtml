@model IEnumerable<DanialNetFood.Web.Models.Restaurant>
@{
    ViewData["Title"] = "رستوران‌ها";
}

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    @foreach (var rest in Model)
    {
        <div class="bg-white rounded-lg shadow overflow-hidden hover:shadow-lg transition">
            <img src="https://placehold.co/600x400?text=@rest.Name" alt="@rest.Name" class="w-full h-48 object-cover">
            <div class="p-4">
                <h3 class="text-xl font-bold mb-2">@rest.Name</h3>
                <p class="text-gray-600 mb-4">@rest.Description</p>
                <a asp-action="Menu" asp-route-id="@rest.Id" class="inline-block bg-red-600 text-white px-6 py-2 rounded hover:bg-red-700">مشاهده منو</a>
            </div>
        </div>
    }
</div>
