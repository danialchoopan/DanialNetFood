@model IEnumerable<DanialNetFood.Web.Models.Restaurant>
@{
    ViewData["Title"] = "رستوران‌ها";
}

<div class="mb-10">
    <h1 class="text-4xl font-black text-slate-900 mb-2">رستوران‌های اطراف شما</h1>
    <p class="text-slate-500 font-medium">بهترین رستوران‌ها و کافه‌ها با منوهای متنوع</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-2 gap-8">
    @foreach (var rest in Model)
    {
        <div class="premium-card group overflow-hidden">
            <div class="relative h-56 overflow-hidden">
                <img src="@rest.ImageUrl" alt="@rest.Name" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                <div class="absolute bottom-4 right-4 text-white">
                    <span class="bg-red-600 px-3 py-1 rounded-md text-xs font-bold mb-2 inline-block">تخفیف ویژه</span>
                    <h3 class="text-2xl font-black">@rest.Name</h3>
                </div>
            </div>
            <div class="p-6">
                <p class="text-slate-500 text-sm mb-6 line-clamp-2 h-10">@rest.Description</p>
                <div class="flex justify-between items-center">
                    <div class="flex items-center gap-1 text-orange-500">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                        <span class="font-bold text-slate-700">۴.۸</span>
                    </div>
                    <a asp-action="Menu" asp-route-id="@rest.Id" class="inline-flex items-center gap-2 font-bold text-red-600 hover:gap-3 transition-all">
                        مشاهده منوی کامل
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    }
</div>
